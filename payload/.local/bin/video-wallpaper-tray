#!/usr/bin/env python3

import fcntl
import json
import os
import socket
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")

from gi.repository import Gtk, GLib


HOME = os.path.expanduser("~")

CTRL = os.path.join(
    HOME,
    ".local/bin/video-wallpaper"
)

ICON = os.path.join(
    HOME,
    ".local/share/icons/Gruvbox-Plus-Dark/apps/scalable/rain-gruvbox.svg"
)

STATE = os.path.join(
    HOME,
    ".local/state/video-wallpaper"
)

RUNDIR = os.environ.get(
    "XDG_RUNTIME_DIR",
    "/tmp"
)

SOCKET = os.path.join(
    RUNDIR,
    f"raincarroof-{os.getuid()}.sock"
)

os.makedirs(STATE, exist_ok=True)


# ---------- uma única instância ----------

lockfile = open(
    os.path.join(STATE, "tray-menu.lock"),
    "w"
)

try:
    fcntl.flock(
        lockfile,
        fcntl.LOCK_EX | fcntl.LOCK_NB
    )
except BlockingIOError:
    sys.exit(0)


# ---------- MPV IPC ----------

request_id = 0


def mpv_request(command):
    global request_id

    if not os.path.exists(SOCKET):
        return None

    request_id += 1

    try:
        s = socket.socket(
            socket.AF_UNIX,
            socket.SOCK_STREAM
        )

        s.settimeout(0.8)
        s.connect(SOCKET)

        payload = {
            "command": command,
            "request_id": request_id,
        }

        s.sendall(
            (json.dumps(payload) + "\n").encode()
        )

        data = b""

        while b"\n" not in data:
            part = s.recv(4096)

            if not part:
                break

            data += part

        s.close()

        if not data:
            return None

        response = json.loads(
            data.split(b"\n", 1)[0]
        )

        if response.get("error") != "success":
            return None

        return response.get("data")

    except Exception:
        return None


def current_wallpaper():
    try:
        from Xlib import display, X
        d = display.Display()
        try:
            p = d.screen().root.get_full_property(d.intern_atom('_NET_CURRENT_DESKTOP'), X.AnyPropertyType)
            space = str(int(p.value[0]) + 1)
        finally:
            d.close()
        with open(os.path.join(HOME, '.local/share/gruvbox-cinnamon/espacos/fundos.json')) as f:
            mode = json.load(f)['spaces'][space]['mode']
        return space, mode
    except Exception:
        return '?', 'static'


def control(action):
    subprocess.Popen(
        [sys.executable, os.path.join(HOME, '.local/share/gruvbox-cinnamon/espacos/raincarroof_por_espaco.py'), action],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


# ---------- tray ----------

class InlineVolumeMenu(Gtk.Menu):
    """Mantém o menu aberto ao encaminhar o arraste para o volume."""
    def __init__(self, owner):
        super().__init__()
        self.owner = owner

    def do_button_press_event(self, event):
        if self.owner.slider_event(event, "press"):
            return True
        return Gtk.Menu.do_button_press_event(self, event)

    def do_motion_notify_event(self, event):
        if self.owner.slider_event(event, "motion"):
            return True
        return Gtk.Menu.do_motion_notify_event(self, event)

    def do_button_release_event(self, event):
        if self.owner.slider_event(event, "release"):
            return True
        return Gtk.Menu.do_button_release_event(self, event)


class RainTray:

    def __init__(self):

        self.internal = False
        self.dragging_volume = False

        self.icon = Gtk.StatusIcon()

        if os.path.isfile(ICON):
            self.icon.set_from_file(ICON)
        else:
            self.icon.set_from_icon_name(
                "weather-showers"
            )

        self.icon.set_visible(True)

        self.icon.set_tooltip_text(
            "Rain — white noise"
        )

        self.menu = InlineVolumeMenu(self)
        self.menu.connect("deactivate", self.end_volume_drag)

        # Status
        self.status_item = Gtk.MenuItem(
            label="Rain"
        )

        self.status_item.set_sensitive(False)

        self.menu.append(
            self.status_item
        )

        self.menu.append(
            Gtk.SeparatorMenuItem()
        )

        # Volume embutido no próprio menu
        volume_item = Gtk.MenuItem()
        volume_item.connect("button-press-event", lambda w, e: self.slider_event(e, "press"))
        volume_item.connect("motion-notify-event", lambda w, e: self.slider_event(e, "motion"))
        volume_item.connect("button-release-event", lambda w, e: self.slider_event(e, "release"))

        volume_box = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=8
        )

        volume_box.set_border_width(7)

        label = Gtk.Label(
            label="Volume"
        )

        self.scale = Gtk.Scale.new_with_range(
            Gtk.Orientation.HORIZONTAL,
            0,
            100,
            1
        )

        self.scale.set_size_request(
            210,
            -1
        )

        self.scale.set_draw_value(True)

        self.scale.set_value_pos(
            Gtk.PositionType.RIGHT
        )

        self.scale.connect(
            "value-changed",
            self.volume_changed
        )

        volume_box.pack_start(
            label,
            False,
            False,
            0
        )

        volume_box.pack_start(
            self.scale,
            True,
            True,
            0
        )

        volume_item.add(
            volume_box
        )

        self.menu.append(
            volume_item
        )

        # Mudo
        self.mute_item = Gtk.CheckMenuItem(
            label="Silenciar"
        )

        self.mute_item.connect(
            "toggled",
            self.mute_changed
        )

        self.menu.append(
            self.mute_item
        )

        self.menu.append(
            Gtk.SeparatorMenuItem()
        )

        # Controles
        start = Gtk.MenuItem(
            label="Iniciar nesta área"
        )

        stop = Gtk.MenuItem(
            label="Parar nesta área"
        )

        restart = Gtk.MenuItem(
            label="Reiniciar vídeo nesta área"
        )

        start.connect(
            "activate",
            lambda *_: control("start")
        )

        stop.connect(
            "activate",
            lambda *_: control("stop")
        )

        restart.connect(
            "activate",
            lambda *_: control("restart")
        )

        self.menu.append(start)
        self.menu.append(stop)
        self.menu.append(restart)
        choose_video = Gtk.MenuItem(label="Escolher vídeo de fundo…")
        choose_video.connect("activate", lambda *_: subprocess.Popen(
            ["/usr/bin/python3", os.path.expanduser("~/.local/lib/rain/painel.py"), "--choose"],
            start_new_session=True))
        self.menu.append(choose_video)


        self.menu.append(
            Gtk.SeparatorMenuItem()
        )

        quit_item = Gtk.MenuItem(
            label="Sair do controle"
        )

        quit_item.connect(
            "activate",
            lambda *_: Gtk.main_quit()
        )

        self.menu.append(
            quit_item
        )

        self.menu.show_all()

        # Clique esquerdo e direito abrem o mesmo menu.
        self.icon.connect(
            "activate",
            self.left_click
        )

        self.icon.connect(
            "popup-menu",
            self.right_click
        )

        GLib.timeout_add_seconds(
            2,
            self.refresh
        )

        self.refresh()

    def popup(self, button=0, event_time=0):

        self.refresh()

        self.menu.popup(
            None,
            None,
            Gtk.StatusIcon.position_menu,
            self.icon,
            button,
            event_time or Gtk.get_current_event_time(),
        )

    def left_click(self, *_):
        self.popup()

    def right_click(
        self,
        _icon,
        button,
        event_time
    ):
        self.popup(
            button,
            event_time
        )

    def slider_event(self, event, action):
        scale = getattr(self, "scale", None)
        if scale is None or not scale.get_sensitive() or not scale.get_realized():
            self.dragging_volume = False
            return False
        top = scale.get_toplevel()
        origin = top.get_window().get_origin()
        offset = scale.translate_coordinates(top, 0, 0)
        x = event.x_root - origin[-2] - offset[0]
        y = event.y_root - origin[-1] - offset[1]
        inside = 0 <= x <= scale.get_allocated_width() and 0 <= y <= scale.get_allocated_height()
        if action == "press":
            if event.button != 1 or not inside:
                return False
            self.dragging_volume = True
        elif not self.dragging_volume:
            return False
        if action == "release" and event.button != 1:
            return False
        rect = scale.get_range_rect()
        start, end = scale.get_slider_range()
        half = (end - start) / 2
        left, right = rect.x + half, rect.x + rect.width - half
        fraction = min(1.0, max(0.0, (x - left) / max(1, right - left)))
        if scale.get_inverted():
            fraction = 1.0 - fraction
        adjustment = scale.get_adjustment()
        scale.set_value(round(adjustment.get_lower() + fraction * (adjustment.get_upper() - adjustment.get_lower())))
        if action == "release":
            self.dragging_volume = False
        return True

    def end_volume_drag(self, *_):
        self.dragging_volume = False

    def volume_changed(self, widget):

        if self.internal:
            return

        value = int(
            round(widget.get_value())
        )

        mpv_request(
            [
                "set_property",
                "volume",
                value,
            ]
        )

    def mute_changed(self, widget):

        if self.internal:
            return

        mpv_request(
            [
                "set_property",
                "mute",
                bool(widget.get_active()),
            ]
        )

    def refresh(self):

        volume = mpv_request(
            [
                "get_property",
                "volume",
            ]
        )

        mute = mpv_request(
            [
                "get_property",
                "mute",
            ]
        )

        self.internal = True

        space, mode = current_wallpaper()

        if volume is None or mode == "static":

            self.status_item.set_label(
                "Área " + space + " — imagem estática"
            )

            self.scale.set_sensitive(
                False
            )

            self.mute_item.set_sensitive(
                False
            )

        else:

            self.status_item.set_label(
                "Área " + space + " — Rain"
            )

            self.scale.set_sensitive(
                True
            )

            self.mute_item.set_sensitive(
                True
            )

            if not self.dragging_volume:
                self.scale.set_value(float(volume))

            self.mute_item.set_active(
                bool(mute)
            )

        self.internal = False

        return True


if __name__ == "__main__":
    RainTray()
    Gtk.main()
